<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FastAction.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fast Action">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        IsTabStop="True"
        KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="MenuRow"
            Padding="8,4,8,0">
            <MenuBar
                x:Name="OverlayMenu"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="SettingsToggleButton"
                    Width="32"
                    Height="28"
                    Padding="0"
                    Click="SettingsToggleButton_Click"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>
                <Button
                    x:Name="CloseOverlayButton"
                    Width="32"
                    Height="28"
                    Padding="0"
                    Click="CloseOverlayButton_Click"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            x:Name="SettingsPane"
            Grid.Row="1"
            Margin="12,8,12,0"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Start at" />
                        <TextBlock
                            x:Name="OriginHint"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Click a key to set the top-left of the grid." />
                        <StackPanel
                            x:Name="OriginPickerHost"
                            Spacing="3" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="168"
                        Spacing="10">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Matrix size" />
                        <NumberBox
                            x:Name="ColumnsBox"
                            Header="Columns"
                            LargeChange="1"
                            Maximum="10"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="SizeBox_ValueChanged" />
                        <NumberBox
                            x:Name="RowsBox"
                            Header="Rows"
                            LargeChange="1"
                            Maximum="4"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="SizeBox_ValueChanged" />
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Appearance" />
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="11" Text="Theme" />
                        <ComboBox
                            x:Name="ThemeBox"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="AppearanceCombo_SelectionChanged">
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontSize="11" Text="Tiles" />
                        <ComboBox
                            x:Name="TileSizeBox"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="AppearanceCombo_SelectionChanged">
                            <x:String>Compact</x:String>
                            <x:String>Default</x:String>
                            <x:String>Large</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="11" Text="Corners" />
                        <ComboBox
                            x:Name="CornerBox"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="AppearanceCombo_SelectionChanged">
                            <x:String>Sharp</x:String>
                            <x:String>Rounded</x:String>
                            <x:String>Pill</x:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <ToggleSwitch
                            x:Name="AcrylicSwitch"
                            Header="Acrylic"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="AcrylicSwitch_Toggled" />
                        <TextBlock x:Name="OpacityLabel" FontSize="11" Text="Opacity" />
                        <Slider
                            x:Name="OpacitySlider"
                            Maximum="100"
                            Minimum="20"
                            StepFrequency="1"
                            TickFrequency="10"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontSize="11" Text="Blur" />
                        <ComboBox
                            x:Name="BlurBox"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="AppearanceCombo_SelectionChanged">
                            <x:String>Standard</x:String>
                            <x:String>Soft</x:String>
                        </ComboBox>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11"
                            Text="Lucide color" />
                        <StackPanel
                            x:Name="LucideDefaultColorHost"
                            Orientation="Horizontal"
                            Spacing="4" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel
            x:Name="RowsHost"
            Grid.Row="2"
            Margin="12,12,12,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8" />

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            Margin="12,0,12,12"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
