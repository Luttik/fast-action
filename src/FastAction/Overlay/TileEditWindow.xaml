<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FastAction.Overlay.TileEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit action">
    <Grid
        x:Name="RootGrid"
        Padding="20"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <Border
                Width="72"
                Height="72"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Image
                        x:Name="PreviewImage"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="PreviewPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No icon"
                        TextAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Edit action" />
                <TextBlock
                    x:Name="KeyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Key" />
                <TextBlock
                    x:Name="PreviewStatus"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBox
                    x:Name="NameBox"
                    Header="Name"
                    PlaceholderText="e.g. Terminal" />

                <ComboBox
                    x:Name="IconTypeBox"
                    HorizontalAlignment="Stretch"
                    Header="Icon type"
                    SelectionChanged="IconTypeBox_SelectionChanged">
                    <x:String>lucide</x:String>
                    <x:String>app</x:String>
                    <x:String>svg</x:String>
                </ComboBox>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="IconValueBox"
                        Header="Icon"
                        PlaceholderText="wrench · notepad.exe · icons/my.svg"
                        TextChanged="IconValueBox_TextChanged" />
                    <Button
                        x:Name="BrowseButton"
                        Grid.Column="1"
                        Margin="0,26,0,0"
                        Click="BrowseButton_Click"
                        Content="Browse…"
                        Visibility="Collapsed" />
                </Grid>

                <ComboBox
                    x:Name="ActionTypeBox"
                    HorizontalAlignment="Stretch"
                    Header="Action type"
                    SelectionChanged="ActionTypeBox_SelectionChanged">
                    <x:String>shell</x:String>
                    <x:String>grid</x:String>
                    <x:String>hotkey</x:String>
                </ComboBox>

                <StackPanel
                    x:Name="HotkeyPanel"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="HotkeyChordBox"
                        Header="Shortcut"
                        IsReadOnly="True"
                        PlaceholderText="Not set — press Record, then the keys" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="RecordHotkeyButton"
                            HorizontalAlignment="Stretch"
                            Click="RecordHotkeyButton_Click"
                            Content="Record shortcut" />
                        <Button
                            x:Name="ClearHotkeyButton"
                            Grid.Column="1"
                            Click="ClearHotkeyButton_Click"
                            Content="Clear" />
                    </Grid>
                    <TextBlock
                        x:Name="HotkeyHintText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Press the combination once. Esc cancels recording."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <TextBox
                    x:Name="CommandBox"
                    Header="Command"
                    PlaceholderText="wt.exe · cursor · https://… · grid id · S" />

                <TextBox
                    x:Name="ArgsBox"
                    Header="Args (space-separated, optional)"
                    PlaceholderText="C:\workspace" />

                <TextBox
                    x:Name="CwdBox"
                    Header="Working directory (optional)" />

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ClearButton"
                HorizontalAlignment="Left"
                Click="ClearButton_Click"
                Content="Clear" />
            <Button
                Grid.Column="1"
                Click="CancelButton_Click"
                Content="Cancel" />
            <Button
                Grid.Column="3"
                Click="SaveButton_Click"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
